{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/block-dangerous.sh",
            "statusMessage": "Checking command safety..."
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/confirm-external-impact.sh"
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/guard-readonly-postgres.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/guard-dashes.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/auto-lint.sh",
            "statusMessage": "Auto-linting..."
          }
        ]
      }
    ]
  }
}
