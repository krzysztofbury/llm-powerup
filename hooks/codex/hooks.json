{
  "description": "skills: lint files changed through Codex apply_patch.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_HOME:-$HOME/.codex}/hooks/auto-lint.mjs\"",
            "timeout": 60,
            "statusMessage": "Checking edited files"
          }
        ]
      }
    ]
  }
}
