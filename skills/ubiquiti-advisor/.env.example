# Copy to .env in this directory or to ~/.config/ubiquiti-advisor/.env,
# then chmod 600. Never commit the copy.
UNIFI_URL=https://unifi.example.internal
UNIFI_SITE=default

# Either an API key, if the controller supports it:
# UNIFI_API_KEY=replace-me

# Or a dedicated local view-only account:
UNIFI_USERNAME=replace-me
UNIFI_PASSWORD=replace-me

# Optional:
# UNIFI_CA_CERT=/path/to/controller-ca.pem
# UNIFI_API_PREFIX=/proxy/network
# UNIFI_LOGIN_PATH=/api/auth/login
# UNIFI_ALLOWED_ENDPOINTS="stat/sysinfo stat/health stat/device"
